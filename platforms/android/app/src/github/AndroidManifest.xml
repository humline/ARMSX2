<?xml version="1.0" encoding="utf-8"?>
<!--
  GitHub (sideload) flavor only. The manifest merger adds the in-app updater
  capability; storage remains SAF-scoped in both distribution flavors.
  This file must NEVER exist for the play flavor because REQUEST_INSTALL_PACKAGES
  enables installing a downloaded APK, which Play policy does not permit.
  The play flavor inherits the clean src/main manifest (no src/play manifest),
  and build-play-aab.sh verifies that the updater permission is absent.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- In-app GitHub-release updater (github flavor only) — install the downloaded APK. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- FileProvider that hands the downloaded update APK to the package installer. Github flavor
         only (merged into the main <application>); never present in the play build. -->
    <application>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updateprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>

</manifest>
